# ============================================================
# .env.example — Copy this to .env for local development
# NEVER commit .env to git. .env is in .gitignore.
# ============================================================

# ── App ────────────────────────────────────────────────────
APP_NAME="Saha Sobriety Companion"
APP_VERSION="0.1.0"
ENVIRONMENT="dev"

# ── Security ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="REPLACE_ME_generate_with_openssl_rand_hex_32"

# ── Database ───────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://saha:saha_dev_password@localhost:5432/saha_dev"

# ── AI providers ───────────────────────────────────────────
# Set to your actual key — never commit this
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-20250514"

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL="DEBUG"

# ── Feature flags ──────────────────────────────────────────
# Keep false until the relevant sprint is complete
AI_ENABLED=false
MEMORY_ENABLED=false

# ── CORS ───────────────────────────────────────────────────
# Add your Expo dev server URL when doing frontend integration
# ALLOWED_ORIGINS=["http://localhost:8081"]
